{
  "name": "@diagramc/web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p tsconfig.e2e.json --pretty false",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "format:check": "biome format --check src",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@antv/x6": "3.1.8",
    "elkjs": "0.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^7.0.2",
    "vite": "8.2.2"
  }
}
